# Vite carga automáticamente frontend/.env — solo las variables con prefijo
# VITE_ llegan al código del cliente (import.meta.env.VITE_*).
#
# Fase 1 no requiere credenciales en el frontend.
#
# Copiar a frontend/.env para sobreescribir valores (frontend/.env está en
# .gitignore y scripts/setup.sh lo crea automáticamente la primera vez si no existe).

VITE_API_BASE_URL=http://localhost:8000
