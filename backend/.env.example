# Variables leídas por scripts/setup.sh al levantar el backend en local.
#
# Fase 1 no requiere credenciales: DMR (config/models.yaml) corre en el host
# sin autenticación. No hay ningún secreto real en este archivo.
#
# Copiar a backend/.env para sobreescribir valores (backend/.env está en
# .gitignore y scripts/setup.sh lo crea automáticamente la primera vez si no existe).

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Fase 2 (Azure AI Foundry, WP-11) añadirá aquí las variables de Entra ID
# cuando exista ese provider — nunca una api_key en producción
# (ver docs/arquitectura.md §9, punto 1).
